# Spotify API Configuration
# Get these from https://developer.spotify.com/dashboard/applications

# Your Spotify app's Client ID (32 character alphanumeric string)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Your Spotify app's Client Secret (32 character alphanumeric string)
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Long-lived refresh token for accessing the Spotify API
# Generate this by running: npm run spotify-auth
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# Optional Environment Variables

# Application environment (development, staging, production)
# NODE_ENV=development

# API response cache duration in seconds (default: 60)
# API_CACHE_DURATION=60

# Vercel-specific (automatically set by Vercel)
# VERCEL_ENV=development

# Rate Limiting Configuration (Upstash Redis)
# Get these from https://console.upstash.com/redis
# If not provided, the API will use in-memory rate limiting (NOT recommended for production)

# Upstash Redis REST URL (required for production rate limiting)
# UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io

# Upstash Redis REST Token (required for production rate limiting)
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here